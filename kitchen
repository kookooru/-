<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>청춘주막 주방 주문 관리 시스템 (KDS)</title>
  <style>
    :root {
      --bg-color: #0f172a;
      --card-bg: #1e293b;
      --border-color: #334155;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --accent-blue: #38bdf8;
      --accent-green: #22c55e;
      --accent-yellow: #facc15;
      --accent-red: #ef4444;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      padding: 20px;
      min-height: 100vh;
    }

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 20px;
      border-bottom: 2px solid var(--border-color);
      margin-bottom: 24px;
    }

    .title-group {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    h1 {
      font-size: 24px;
      font-weight: 700;
      color: var(--accent-blue);
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background-color: #0284c720;
      color: var(--accent-blue);
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 14px;
      font-weight: 600;
      border: 1px solid #0284c740;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: var(--accent-green);
      box-shadow: 0 0 8px var(--accent-green);
    }

    .controls {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .refresh-info {
      font-size: 14px;
      color: var(--text-muted);
    }

    .btn {
      background-color: var(--card-bg);
      color: var(--text-main);
      border: 1px solid var(--border-color);
      padding: 10px 18px;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
    }

    .btn-primary {
      background-color: #0284c7;
      border-color: #0284c7;
      color: #fff;
    }

    .orders-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 20px;
    }

    .empty-state {
      grid-column: 1 / -1;
      text-align: center;
      padding: 80px 20px;
      background-color: var(--card-bg);
      border-radius: 16px;
      border: 2px dashed var(--border-color);
    }

    .empty-state h2 {
      font-size: 20px;
      color: var(--text-muted);
      margin-bottom: 8px;
    }

    .order-card {
      background-color: var(--card-bg);
      border: 2px solid var(--border-color);
      border-radius: 16px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);
    }

    .card-header {
      background-color: #0f172a80;
      padding: 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--border-color);
    }

    .table-badge {
      background-color: var(--accent-yellow);
      color: #0f172a;
      font-size: 20px;
      font-weight: 800;
      padding: 6px 14px;
      border-radius: 10px;
    }

    .order-time {
      font-size: 18px;
      font-weight: 700;
      color: var(--accent-blue);
      text-align: right;
    }

    .card-body {
      padding: 20px;
      flex-grow: 1;
    }

    .items-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .item-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 20px;
      font-weight: 700;
      padding-bottom: 10px;
      border-bottom: 1px solid #33415550;
    }

    .item-row:last-child {
      border-bottom: none;
    }

    .item-qty {
      background-color: #38bdf820;
      color: var(--accent-blue);
      border: 1px solid #38bdf840;
      padding: 4px 12px;
      border-radius: 8px;
    }

    .card-footer {
      padding: 16px;
      background-color: #0f172a40;
      border-top: 1px solid var(--border-color);
    }

    .btn-complete {
      width: 100%;
      background-color: var(--accent-green);
      color: #ffffff;
      border: none;
      padding: 14px;
      border-radius: 10px;
      font-size: 18px;
      font-weight: 700;
      cursor: pointer;
    }
  </style>
</head>
<body>

  <header>
    <div class="title-group">
      <h1>🍶 청춘주막 주방 디스플레이 (KDS)</h1>
      <div class="status-badge">
        <span class="status-dot"></span>
        실시간 자동 동기화 (5초)
      </div>
    </div>
    <div class="controls">
      <span class="refresh-info" id="last-update">최신화: 방금 전</span>
      <button class="btn btn-primary" onclick="fetchKitchenOrders()">🔄 수동 새로고침</button>
    </div>
  </header>

  <main>
    <div id="orders-container" class="orders-grid">
      <!-- 주문 카드가 동적으로 생성됩니다 -->
    </div>
  </main>

  <script>
    const CONFIG = {
      // 본인의 Apps Script 웹 앱 URL을 붙여넣으세요
      SCRIPT_URL: "여기에_STEP3에서_복사한_웹앱_URL_붙여넣기",
      REFRESH_INTERVAL: 5000 // 5초마다 새로고침
    };

    window.addEventListener('DOMContentLoaded', () => {
      fetchKitchenOrders();
      setInterval(fetchKitchenOrders, CONFIG.REFRESH_INTERVAL);
    });

    async function fetchKitchenOrders() {
      if (!CONFIG.SCRIPT_URL || CONFIG.SCRIPT_URL.includes("여기에_")) {
        renderError("CONFIG.SCRIPT_URL 설정이 필요합니다.");
        return;
      }

      try {
        const response = await fetch(`${CONFIG.SCRIPT_URL}?action=kitchen`);
        const data = await response.json();

        if (data.success) {
          renderOrders(data.orders || []);
          updateLastTime();
        }
      } catch (error) {
        console.error("네트워크 에러:", error);
      }
    }

    function renderOrders(orders) {
      const container = document.getElementById('orders-container');

      if (!orders || orders.length === 0) {
        container.innerHTML = `
          <div class="empty-state">
            <h2>대기 중인 조리 주문이 없습니다 🎉</h2>
            <p>시트에서 '입금확인여부'를 '확인'으로 변경하면 주방으로 전송됩니다.</p>
          </div>
        `;
        return;
      }

      container.innerHTML = orders.map(order => {
        const items = parseOrderSummary(order.itemsSummary);

        return `
          <div class="order-card" id="card-${order.orderNumber}">
            <div class="card-header">
              <div class="table-badge">테이블 ${order.table}</div>
              <div class="order-time">⏱ ${order.time}</div>
            </div>
            <div class="card-body">
              <ul class="items-list">
                ${items.map(item => `
                  <li class="item-row">
                    <span class="item-name">${item.name}</span>
                    <span class="item-qty">${item.qty}개</span>
                  </li>
                `).join('')}
              </ul>
            </div>
            <div class="card-footer">
              <button class="btn-complete" onclick="completeCooking('${order.orderNumber}')">
                ✅ 조리 완료
              </button>
            </div>
          </div>
        `;
      }).join('');
    }

    function parseOrderSummary(summary) {
      if (!summary) return [];
      return summary.split(', ').map(part => {
        const lastX = part.lastIndexOf(' x');
        if (lastX !== -1) {
          return {
            name: part.substring(0, lastX),
            qty: part.substring(lastX + 2)
          };
        }
        return { name: part, qty: '1' };
      });
    }

    async function completeCooking(orderNumber) {
      const card = document.getElementById(`card-${orderNumber}`);
      if (card) card.style.opacity = '0.3';

      try {
        const response = await fetch(CONFIG.SCRIPT_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify({
            action: 'completeCooking',
            orderNumber: orderNumber
          })
        });

        const data = await response.json();
        if (data.success) {
          fetchKitchenOrders();
        } else {
          alert('처리 실패: ' + data.message);
          if (card) card.style.opacity = '1';
        }
      } catch (error) {
        alert('서버 에러가 발생했습니다.');
        if (card) card.style.opacity = '1';
      }
    }

    function updateLastTime() {
      const now = new Date();
      document.getElementById('last-update').innerText = `최신화: ${now.toLocaleTimeString('ko-KR')}`;
    }

    function renderError(msg) {
      document.getElementById('orders-container').innerHTML = `
        <div class="empty-state" style="border-color: var(--accent-red);">
          <h2 style="color: var(--accent-red);">${msg}</h2>
        </div>
      `;
    }
  </script>
</body>
</html>
